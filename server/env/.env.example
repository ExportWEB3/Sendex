# Sendex backend development environment
# Copy this file to .env and replace placeholders locally. Never commit real secrets.

# Runtime
ENVIRONMENT=development
BASE_URL=http://localhost:8090
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/sendex
REDIS_URL=redis://localhost:6379/0
UPLOADS_DIR=uploads

# Authentication and request protection
SECRET_KEY=replace-with-a-long-random-secret
API_APP_KEY=replace-with-a-separate-random-app-key
TRACKING_SECRET=replace-with-a-separate-tracking-secret
AUTH_FROM_EMAIL=no-reply@example.com
AUTH_FROM_NAME=Sendex

# Resend delivery and webhook integration
RESEND_API_KEY=
RESEND_VERIFIED_DOMAIN=example.com
RESEND_WEBHOOK_SECRET=

# Optional IMAP reply collection
RESEND_IMAP_HOST=
RESEND_IMAP_PORT=993
RESEND_IMAP_USER=
RESEND_IMAP_PASS=

# Optional AI assistant
ASSISTANT_PROVIDER=deepseek
ASSISTANT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
GEMINI_API_KEY=
AI_MODEL=
AI_REPLIES_ENABLED=false

# Delivery safety
DOMAIN_DAILY_BUDGET=100000
DOMAIN_MINUTE_BUDGET=100
DOMAIN_DAILY_BOUNCE_LIMIT=50
DOMAIN_COMPLAINT_RATE_MAX=0.01
DOMAIN_MIN_SAMPLE_FOR_HEALTH=500
DOMAIN_THROTTLE_TTL_SECONDS=3600

# Warm-up policy
WARMUP_DAYS=30
WARMUP_START_VOLUME=5
WARMUP_END_VOLUME=50
WARMUP_MAX_VOLUME=50
WARMUP_RAMP_DAYS=30
WARMUP_SHARE=0.30
WARMUP_INFINITE=true

# Worker process (set per worker instance)
WORKER_NAME=development-worker
WORKER_TIMEZONE=US/Eastern
WORKER_INSTANCES=1
ALLOW_UNSCOPED_WORKER=true

# Optional Telegram worker alerts
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
ALERT_ENV_NAME=development
ALERT_MONITOR_INTERVAL_SECONDS=60
ALERT_MIN_REPEAT_SECONDS=900
ALERT_HEARTBEAT_STALE_SECONDS=300
ALERT_WORKER_STATUS_STALE_SECONDS=300
ALERT_RECOVERY_ENABLED=true
